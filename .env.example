DATABASE_URL=postgres://rundea:rundea@localhost:54329/rundea
RUNDEA_CONTROL_TOKEN=local-dev-only-control-token-0123456789abcdef
# Local development key only. Production must use a separately generated 32-byte base64 key.
RUNDEA_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Runtime environment. development keeps localhost defaults. staging/production are fail-closed.
RUNDEA_ENVIRONMENT=development
RUNDEA_API_URL=http://localhost:4000
RUNDEA_WEB_ORIGIN=http://localhost:5173
# Required in staging/production. HTTPS origin only, no path/query/fragment.
# Production target: https://rundea.buxopus.com
# Staging target: https://rundea-staging.buxopus.com
RUNDEA_PUBLIC_ORIGIN=
# Production node bootstrap/control-plane origin. In staging/production it must equal RUNDEA_PUBLIC_ORIGIN.
RUNDEA_PUBLIC_CONTROL_PLANE_URL=
# Public web remains disabled until a real browser auth boundary exists. `external-auth` means a separately configured trusted access gateway protects the web/admin surface.
RUNDEA_PUBLIC_WEB_MODE=disabled

# Optional: read-only MCP HTTP. Static token and OAuth modes are mutually exclusive.
RUNDEA_MCP_TOKEN=
RUNDEA_MCP_ALLOWED_HOSTS=
RUNDEA_MCP_ALLOWED_ORIGINS=
# OAuth mode. In staging/production RUNDEA_MCP_OAUTH_RESOURCE must equal <RUNDEA_PUBLIC_ORIGIN>/mcp.
RUNDEA_MCP_OAUTH_ISSUER=
RUNDEA_MCP_OAUTH_RESOURCE=
RUNDEA_MCP_OAUTH_JWKS_URI=

# Optional: required only for signed GitHub push autodeploy.
RUNDEA_GITHUB_WEBHOOK_SECRET=
# Optional pair: enables Source Broker access to private repositories installed for the Rundea GitHub App.
# Store the GitHub App PEM private key as base64; never commit a real key.
RUNDEA_GITHUB_APP_ID=
RUNDEA_GITHUB_APP_PRIVATE_KEY_BASE64=
# Optional pair: fixed immutable private GitHub Release used by Control Plane to distribute Agent binaries.
# The Rundea GitHub App must be installed on this repository with contents:read.
RUNDEA_AGENT_RELEASE_REPOSITORY=
RUNDEA_AGENT_RELEASE_TAG=

# Optional: private OCI registry pull credentials held only by the Control Plane.
# The registry host is derived from RUNDEA_BUILD_REGISTRY_PREFIX. Production Agents
# receive only a short-lived, single-use broker ticket and use a temporary DOCKER_CONFIG.
RUNDEA_REGISTRY_PULL_USERNAME=
RUNDEA_REGISTRY_PULL_PASSWORD=
PORT=4000
