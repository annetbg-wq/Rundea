FROM golang:1.25-bookworm AS agent-builder

ARG RUNDEA_BUILD_SHA=development
WORKDIR /src/apps/agent
COPY apps/agent/go.mod apps/agent/go.sum ./
RUN go mod download
COPY apps/agent .
RUN mkdir -p /out \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.agentBuildSHA=${RUNDEA_BUILD_SHA}" -o /out/rundea-agent-linux-amd64 . \
  && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w -X main.agentBuildSHA=${RUNDEA_BUILD_SHA}" -o /out/rundea-agent-linux-arm64 . \
  && cp VERSION /out/VERSION \
  && test -s /out/rundea-agent-linux-amd64 \
  && test -s /out/rundea-agent-linux-arm64 \
  && test -s /out/VERSION

FROM node:24-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/crypto/package.json packages/crypto/package.json
COPY packages/deployer/package.json packages/deployer/package.json

RUN npm ci --ignore-scripts

COPY tsconfig.base.json ./
COPY apps/api apps/api
COPY packages packages
COPY infra/agent infra/agent
COPY infra/live infra/live
COPY --from=agent-builder /out /app/agent-release

RUN test -s infra/agent/install.sh \
  && test -s infra/live/DEPLOY_STAGING.sh \
  && test -s infra/live/docker-compose.staging.yml \
  && test -s /app/agent-release/rundea-agent-linux-amd64 \
  && test -s /app/agent-release/rundea-agent-linux-arm64 \
  && test -s /app/agent-release/VERSION

ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000

CMD ["npm", "run", "start", "-w", "@rundea/api"]
