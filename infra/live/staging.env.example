# Pin to an immutable 40-character commit SHA published by live-runtime-image.
RUNDEA_IMAGE_TAG=c6cd0d4b91e14f722c4a2b6c954a8c7a500c1fe1

# Generate unique staging-only values. Do not reuse production secrets/state.
POSTGRES_PASSWORD=replace-with-long-random-staging-password
RUNDEA_CONTROL_TOKEN=replace-with-long-random-staging-control-token
RUNDEA_MASTER_KEY=replace-with-32-byte-base64-staging-key

# Optional until MCP is enabled for staging. If set, use a staging-only token.
RUNDEA_MCP_TOKEN=
